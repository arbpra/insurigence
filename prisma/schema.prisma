generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  WAITING_ON_INFO
  READY_TO_MARKET
  QUOTED
  PRESENTED
  BOUND
  LOST
}

enum MarketClassification {
  STANDARD
  EXCESS_SURPLUS
  BORDERLINE
}

enum CarrierFitTier {
  GOOD_FIT
  POSSIBLE_FIT
  REVIEW_NEEDED
  NO_FIT
}

enum LineOfBusiness {
  COMMERCIAL_GL
}

enum CarrierMarketType {
  STANDARD
  EXCESS_SURPLUS
}

/// Proposal lifecycle. SHARED and ACCEPTED from the original enum were renamed to
/// SENT and SIGNED respectively — the concepts are unchanged, the names now match
/// the client-facing workflow. DECLINED is retained: the insured turning a proposal
/// down is a real outcome the Super Admin dashboard reports on.
enum ProposalStatus {
  DRAFT
  READY_TO_SEND
  SENT
  VIEWED
  OPTION_SELECTED
  SIGNED
  DECLINED
  EXPIRED
  REVOKED
}

/// How the insured produced their signature. Both are captured as
/// ProposalSignature.signatureData — typed as text, drawn as a data URL.
enum SignatureType {
  TYPED
  DRAWN
}

/// Every insured-facing milestone in a proposal's life, for the E-Sign Activity log.
enum ProposalEventType {
  CREATED
  SENT
  RESENT
  OPENED
  VIEWED
  OPTION_SELECTED
  OPTION_CHANGED
  SIGNED
  PDF_GENERATED
  LINK_REVOKED
  VERSION_CREATED
  EXPIRED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum LeadSource {
  INTERNAL
  EXTERNAL
}

enum ActivityEventType {
  INTAKE_SUBMITTED_INTERNAL
  INTAKE_SUBMITTED_EXTERNAL
  LEAD_EVALUATED
  PROPOSAL_CREATED
  PROPOSAL_SHARED
  PROPOSAL_VIEWED
  USER_LOGIN
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  AGENCY_CREATED
  AGENCY_UPDATED
  AGENCY_PAUSED
  CARRIER_CREATED
  CARRIER_UPDATED
  APPETITE_RULE_CREATED
  APPETITE_RULE_UPDATED
  INTAKE_FORM_CREATED
  INTAKE_FORM_PUBLIC_TOGGLED
}

enum SubscriptionTier {
  SOLO
  GROWTH
  MULTI_LOCATION
}

enum RiskTolerance {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

enum AgencyStatus {
  ACTIVE
  PAUSED
}

enum PresentationMode {
  STANDARD
  FLASH
  BOTH
}

model Agency {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  primaryEmail         String?
  phone                String?
  website              String?

  subscriptionTier     SubscriptionTier @default(SOLO)
  allowedMarkets       String[]         @default(["standard"])
  riskTolerance        RiskTolerance    @default(BALANCED)
  status               AgencyStatus     @default(ACTIVE)
  placementNotes       String?
  esRecommendationsEnabled Boolean      @default(true)

  brandPrimaryColor    String?
  brandSecondaryColor  String?
  logoUrl              String?
  proposalFooterText   String?
  /// Agency's own proposal disclaimer. Null falls back to the platform default
  /// in lib/proposals/branding.ts, which Super Admin maintains.
  proposalDisclaimerText String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                User[]
  intakeForms          IntakeForm[]
  intakeSubmissions    IntakeSubmission[]
  leads                Lead[]
  carriers             Carrier[]
  appetiteRules        CarrierAppetiteRule[]
  quoteOptions         QuoteOption[]
  proposals            Proposal[]
  aiRuns               AiRun[]
  billingAccount       BillingAccount?
  leadCarrierFits      LeadCarrierFit[]
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId     String?  @db.ObjectId
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  lastLoginAt  DateTime?
  lastActivityAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency       Agency?  @relation(fields: [agencyId], references: [id])
  leads        Lead[]   @relation("AssignedLeads")
  activityEvents ActivityEvent[] @relation("UserEvents")
  sessions     Session[]
  inviteTokens InviteToken[]
  passwordResetTokens PasswordResetToken[]
  createdProposals Proposal[] @relation("CreatedProposals")

  @@index([role])
}

/// One-time password-reset codes. The 6-digit code is stored hashed (never
/// plaintext), is single-use, expires quickly, and limits verification attempts.
model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time invite links. A separate model (rather than a nullable @unique field
/// on User) because MongoDB's unique index rejects a second null — every row here
/// always has a token. The invitee sets their own password via this link, so no
/// password is ever sent by email.
model InviteToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  token     String    @unique
  userId    String    @db.ObjectId
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model IntakeForm {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  agencyId         String           @db.ObjectId
  lob              LineOfBusiness
  name             String
  definition       Json
  isActive         Boolean          @default(true)
  isPublic         Boolean          @default(false)
  publicToken      String?          @unique
  presentationMode PresentationMode @default(STANDARD)
  allowModeToggle  Boolean          @default(false)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  agency      Agency         @relation(fields: [agencyId], references: [id])
  submissions IntakeSubmission[]
}

model IntakeSubmission {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId        String   @db.ObjectId
  intakeFormId    String   @db.ObjectId
  insuredName     String
  contactEmail    String?
  responses       Json
  completenessScore Int    @default(0)
  createdAt       DateTime @default(now())

  agency          Agency   @relation(fields: [agencyId], references: [id])
  intakeForm      IntakeForm @relation(fields: [intakeFormId], references: [id])
  lead            Lead?
}

model Lead {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  agencyId             String              @db.ObjectId
  intakeSubmissionId   String?             @unique @db.ObjectId
  assignedToId         String?             @db.ObjectId
  lob                  LineOfBusiness     @default(COMMERCIAL_GL)

  insuredName            String
  primaryContactEmail    String?
  status                 LeadStatus        @default(NEW)
  source                 LeadSource        @default(INTERNAL)

  marketClassification   MarketClassification?
  marketConfidence       Float?
  marketReasonCodes      String[]           @default([])

  // Archived leads are hidden from the main list and live in the Archived view.
  archivedAt             DateTime?

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  agency                 Agency             @relation(fields: [agencyId], references: [id])
  intakeSubmission       IntakeSubmission?  @relation(fields: [intakeSubmissionId], references: [id])
  assignedTo             User?              @relation("AssignedLeads", fields: [assignedToId], references: [id])

  carrierFits            LeadCarrierFit[]
  quoteOptions           QuoteOption[]
  proposals              Proposal[]
  aiRuns                 AiRun[]
}

model Carrier {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  agencyId     String            @db.ObjectId
  name         String
  marketType   CarrierMarketType @default(STANDARD)
  enabled      Boolean           @default(true)
  priorityRank Int               @default(100)
  notes        String?
  isActive     Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency        Agency               @relation(fields: [agencyId], references: [id])
  appetiteRules CarrierAppetiteRule[]
  appetiteGuides AppetiteGuide[]
  carrierFits   LeadCarrierFit[]
  quoteOptions  QuoteOption[]

  @@unique([agencyId, name])
}

model CarrierAppetiteRule {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  agencyId             String         @db.ObjectId
  carrierId            String         @db.ObjectId
  lob                  LineOfBusiness @default(COMMERCIAL_GL)
  version              Int            @default(1)
  
  allowedIndustries    String[]       @default([])
  excludedIndustries   String[]       @default([])
  allowedStates        String[]       @default([])
  excludedStates       String[]       @default([])
  minRevenue           Int?
  maxRevenue           Int?
  minEmployees         Int?
  maxEmployees         Int?
  minYearsInBusiness   Int?
  lossHistoryYears     Int            @default(5)
  maxLossCount         Int?
  maxLossAmount        Int?
  
  rules                Json?
  summary              String?
  isActive             Boolean        @default(true)
  isAgencyOverride     Boolean        @default(false)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  agency    Agency         @relation(fields: [agencyId], references: [id])
  carrier   Carrier        @relation(fields: [carrierId], references: [id])

  @@unique([carrierId, lob, version])
}

model AppetiteGuide {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  carrierId   String   @db.ObjectId
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  notes       String?
  uploadedAt  DateTime @default(now())

  carrier     Carrier  @relation(fields: [carrierId], references: [id])
}

model LeadCarrierFit {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String         @db.ObjectId
  leadId    String         @db.ObjectId
  carrierId String         @db.ObjectId
  tier      CarrierFitTier
  score     Float?
  reasons   String[]       @default([])
  notes     String?
  createdAt DateTime       @default(now())

  agency    Agency         @relation(fields: [agencyId], references: [id])
  lead      Lead           @relation(fields: [leadId], references: [id])
  carrier   Carrier        @relation(fields: [carrierId], references: [id])

  @@unique([leadId, carrierId])
}

/// A single carrier quote option attached to a Lead. An agent adds one of these
/// per quote received back from a carrier, and a Proposal presents several of
/// them side by side for the insured to compare and choose between.
///
/// Money is stored in whole cents as BigInt (matching the rest of the schema) so
/// premiums are never subject to floating-point drift.
model QuoteOption {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String   @db.ObjectId
  leadId    String   @db.ObjectId
  carrierId String?  @db.ObjectId

  // ── Identity ──
  /// Agent-facing label, e.g. "Option 1". Falls back to the carrier name in UI.
  optionLabel    String?
  /// Free-text carrier name, used when the quote is from a carrier that is not
  /// in the agency's carrier list (e.g. an E&S market placed through a broker).
  carrierName    String?
  programName    String?
  lineOfBusiness LineOfBusiness?
  policyType     String?

  // ── Dates ──
  effectiveDate       DateTime?
  expirationDate      DateTime?
  /// When the carrier's quote itself goes stale, distinct from the policy term.
  quoteExpirationDate DateTime?

  // ── Cost (whole cents) ──
  premiumAnnualCents BigInt?
  taxesCents         BigInt?
  feesCents          BigInt?
  totalAnnualCents   BigInt?
  paymentPlan        String?

  // ── Coverage detail ──
  /// [{ name, limit, deductible, included, explanation, whyItMatters, agentEdited }]
  coverages    Json?
  limits       Json?
  deductibles  Json?
  endorsements Json?
  exclusions   Json?

  notes        String?

  // ── Uploaded carrier quote document ──
  /// Object key in R2, never a URL. Links are presigned per request so access
  /// stays behind the agency check and no long-lived public URL ever exists.
  documentKey         String?
  documentName        String?
  documentSize        Int?
  documentContentType String?
  documentUploadedAt  DateTime?

  /// Exactly one option per proposal should carry the agent's recommendation.
  /// Enforced in application code, not by the database.
  isRecommended Boolean @default(false)
  /// "Why We Recommend This Option" — agent-written or AI-drafted then edited.
  /// Lives on the option so it survives before a proposal exists; a proposal
  /// copies it into Proposal.recommendationText at build time.
  recommendationRationale String?
  /// True while the rationale is an unedited AI draft, so unreviewed text
  /// cannot reach the insured.
  rationaleAiDrafted      Boolean @default(false)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency    Agency   @relation(fields: [agencyId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id])
  carrier   Carrier? @relation(fields: [carrierId], references: [id])

  @@index([agencyId])
  @@index([leadId])
  @@index([leadId, sortOrder])
}

model Proposal {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String        @db.ObjectId
  leadId    String        @db.ObjectId
  createdByUserId String?  @db.ObjectId

  status    ProposalStatus @default(DRAFT)
  title     String

  /// Increments each time a sent proposal is edited. A signed version is never
  /// mutated — editing one creates the next version instead.
  version   Int            @default(1)

  // ── Market-classification proposal (original feature, retained) ──
  marketClassification MarketClassification?
  marketConfidence Float?
  marketSummary String?
  agentRecommendation String?
  snapshot  Json?
  quoteIds  String[]       @default([])

  // ── Quote proposal ──
  /// The option the insured chose. Set at selection time, before signing.
  selectedQuoteOptionId String?  @db.ObjectId
  /// "Why We Recommend This Option" — agent-written or AI-drafted then edited.
  recommendationText    String?
  /// Covering note shown to the insured when the proposal is delivered.
  clientMessage         String?
  /// Resolved at send time from the agency default so a sent proposal keeps the
  /// exact disclaimer it was sent with, even if the agency later changes theirs.
  disclaimerText        String?
  /// Ordered proposal sections: [{ key, title, enabled, body }]
  sections              Json?

  // ── Secure client link ──
  publicToken    String?   @unique
  tokenRevokedAt DateTime?

  // ── Lifecycle timestamps ──
  sentAt     DateTime?
  /// Legacy timestamp from the SHARED status. Retained so existing rows keep
  /// their history; new code writes sentAt.
  sharedAt   DateTime?
  viewedAt   DateTime?
  selectedAt DateTime?
  signedAt   DateTime?
  expiresAt  DateTime?
  /// Set when a signature completes. A locked proposal is immutable.
  lockedAt   DateTime?
  /// The complete client-facing proposal frozen at the moment of signature.
  ///
  /// Data sections (options, coverages, comparison) normally render from the
  /// lead's live quote options, so without this an agent editing a quote after
  /// signature would silently change the document the insured agreed to. Once
  /// set, the public view serves this instead of re-assembling.
  signedSnapshot Json?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  agency     Agency        @relation(fields: [agencyId], references: [id])
  lead       Lead          @relation(fields: [leadId], references: [id])
  createdBy  User?         @relation("CreatedProposals", fields: [createdByUserId], references: [id])

  signatures ProposalSignature[]
  events     ProposalActivityEvent[]

  @@index([agencyId])
  @@index([leadId])
  @@index([status])
}

/// An insured's electronic signature on one version of one proposal.
///
/// Rows here are append-only evidence: they are never updated or deleted, and they
/// carry everything needed to demonstrate intent to sign under ESIGN/UETA — who
/// signed, what they agreed to, which exact proposal version, and from where.
model ProposalSignature {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String  @db.ObjectId
  /// Denormalised for agency-scoped queries without joining through Proposal.
  agencyId   String  @db.ObjectId

  signerName    String
  signerEmail   String?
  signerTitle   String?
  signatureType SignatureType @default(TYPED)
  /// Typed name, or a data-URL image for a drawn signature.
  signatureData String

  consentAccepted Boolean @default(false)
  /// The exact consent wording shown at signing time, stored verbatim.
  consentText     String?

  /// Which option was selected at the moment of signing, and against which
  /// version — both frozen here so later edits cannot rewrite what was signed.
  selectedQuoteOptionId String? @db.ObjectId
  proposalVersion       Int

  signedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?

  proposal  Proposal @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
  @@index([agencyId])
}

/// Timeline entry for the E-Sign Activity log shown to the Agent and Agency Admin.
model ProposalActivityEvent {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String            @db.ObjectId
  agencyId   String            @db.ObjectId
  eventType  ProposalEventType
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime          @default(now())

  proposal   Proposal          @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
  @@index([agencyId])
  @@index([createdAt])
}

enum AiRunStatus {
  COMPLETED
  FAILED
}

model AiRun {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  agencyId      String?     @db.ObjectId
  leadId        String?     @db.ObjectId
  purpose       String
  status        AiRunStatus @default(COMPLETED)
  model         String?
  promptVersion String?

  // What was sent to the model (for audit/history) and what came back.
  inputSnapshot Json?
  output        Json
  usage         Json?
  error         String?

  // Agent review trail. Set when a licensed agent reviews/approves the output.
  reviewedById  String?     @db.ObjectId
  reviewedAt    DateTime?

  createdAt     DateTime    @default(now())

  agency        Agency?     @relation(fields: [agencyId], references: [id])
  lead          Lead?       @relation(fields: [leadId], references: [id])

  @@index([agencyId])
  @@index([leadId])
  @@index([purpose])
  @@index([createdAt])
}

enum AcordFormType {
  ACORD_125
  ACORD_126
  ACORD_140
  ACORD_25
  ACORD_130
}

enum AcordDraftStatus {
  DRAFT
  REVIEWED
  EXPORTED
}

/// Generated ACORD form data — stored separately from the original intake for
/// audit/history, per the AI build direction. `fields` holds the mapped form
/// values (agent-editable); `missingFields` are required keys still blank.
model AcordDraft {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  agencyId      String           @db.ObjectId
  leadId        String           @db.ObjectId
  formType      AcordFormType
  status        AcordDraftStatus @default(DRAFT)

  fields        Json
  missingFields String[]         @default([])

  // Agent review/approval trail before export.
  reviewedById  String?          @db.ObjectId
  reviewedAt    DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([agencyId])
  @@index([leadId])
  @@index([formType])
}

/// Agent-editable coverage recommendations for a lead. Seeded deterministically
/// from intake exposures (+ optional AI-refined explanations), then the agent can
/// edit levels, remove, or add coverages and approve before use in a proposal.
/// One current set per lead. Stored separately for audit/history.
model CoverageRecommendationSet {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  agencyId        String    @db.ObjectId
  leadId          String    @unique @db.ObjectId
  recommendations Json
  status          String    @default("DRAFT") // DRAFT | REVIEWED
  reviewedById    String?   @db.ObjectId
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agencyId])
}

/// Super-admin-editable overrides for the coverage rules library. Global (one
/// row per coverage). Lets non-developers enable/disable coverages, override the
/// plain-English explanation, and add custom coverages — without code changes.
/// The engine's conditional level logic stays in code; these overrides are
/// merged on top of its output.
model CoverageRuleConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  coverageName     String   @unique
  enabled          Boolean  @default(true)
  agentExplanation String?  // override; null = use library default
  isCustom         Boolean  @default(false)
  customLevel      String?  // STRONGLY_RECOMMENDED | RECOMMENDED | CONSIDER | NOT_TYPICALLY_NEEDED
  customReason     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BillingAccount {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String   @unique @db.ObjectId
  stripeCustomerId String?
  stripeSubscriptionId String?
  planCode  String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency    Agency   @relation(fields: [agencyId], references: [id])
}

model ActivityEvent {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  agencyId    String?           @db.ObjectId
  userId      String?           @db.ObjectId
  leadId      String?           @db.ObjectId
  eventType   ActivityEventType
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime          @default(now())

  user        User?             @relation("UserEvents", fields: [userId], references: [id])

  @@index([agencyId])
  @@index([userId])
  @@index([leadId])
  @@index([eventType])
  @@index([createdAt])
}
