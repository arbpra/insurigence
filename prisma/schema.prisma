generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  WAITING_ON_INFO
  READY_TO_MARKET
  QUOTED
  PRESENTED
  /// The insured has signed and approved an option. Insurigence never sets
  /// BOUND on its own — binding is a carrier action a person must confirm
  /// (requirement 13), so this is as far as a signature can move a lead.
  READY_TO_BIND
  BOUND
  LOST
}

enum MarketClassification {
  STANDARD
  EXCESS_SURPLUS
  BORDERLINE
}

enum CarrierFitTier {
  GOOD_FIT
  POSSIBLE_FIT
  REVIEW_NEEDED
  NO_FIT
}

enum LineOfBusiness {
  COMMERCIAL_GL
}

enum CarrierMarketType {
  STANDARD
  EXCESS_SURPLUS
}

/// Proposal lifecycle. SHARED and ACCEPTED from the original enum were renamed to
/// SENT and SIGNED respectively — the concepts are unchanged, the names now match
/// the client-facing workflow. DECLINED is retained: the insured turning a proposal
/// down is a real outcome the Super Admin dashboard reports on.
enum ProposalStatus {
  DRAFT
  READY_TO_SEND
  SENT
  VIEWED
  OPTION_SELECTED
  SIGNED
  DECLINED
  EXPIRED
  REVOKED
}

/// How the insured produced their signature. Both are captured as
/// ProposalSignature.signatureData — typed as text, drawn as a data URL.
enum SignatureType {
  TYPED
  DRAWN
}

/// Every insured-facing milestone in a proposal's life, for the E-Sign Activity log.
enum ProposalEventType {
  CREATED
  SENT
  RESENT
  OPENED
  VIEWED
  OPTION_SELECTED
  OPTION_CHANGED
  SIGNED
  PDF_GENERATED
  LINK_REVOKED
  VERSION_CREATED
  EXPIRED
}

/// SUPER_ADMIN is the platform. ADMIN (agency Owner/Admin), AGENT (shown as
/// "Producer") and CSR are agency roles. The DESK roles are internal Insurigence
/// staff; they never carry an agencyId — their access comes only from Desk
/// assignments (see lib/roles.ts).
enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
  CSR
  DESK_ADMIN
  ACCOUNT_MANAGER
  DESK_VA
}

/// How much of the agency's book an agency user sees in The Desk.
enum BookAccess {
  ALL
  ASSIGNED
}

enum LeadSource {
  INTERNAL
  EXTERNAL
}

enum ActivityEventType {
  INTAKE_SUBMITTED_INTERNAL
  INTAKE_SUBMITTED_EXTERNAL
  LEAD_EVALUATED
  PROPOSAL_CREATED
  PROPOSAL_SHARED
  PROPOSAL_VIEWED
  USER_LOGIN
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  AGENCY_CREATED
  AGENCY_UPDATED
  AGENCY_PAUSED
  CARRIER_CREATED
  CARRIER_UPDATED
  APPETITE_RULE_CREATED
  APPETITE_RULE_UPDATED
  INTAKE_FORM_CREATED
  INTAKE_FORM_PUBLIC_TOGGLED
}

enum SubscriptionTier {
  SOLO
  GROWTH
  MULTI_LOCATION
}

enum RiskTolerance {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

enum AgencyStatus {
  ACTIVE
  PAUSED
}

enum PresentationMode {
  STANDARD
  FLASH
  BOTH
}

model Agency {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  primaryEmail         String?
  phone                String?
  website              String?

  subscriptionTier     SubscriptionTier @default(SOLO)
  allowedMarkets       String[]         @default(["standard"])
  riskTolerance        RiskTolerance    @default(BALANCED)
  status               AgencyStatus     @default(ACTIVE)
  placementNotes       String?
  esRecommendationsEnabled Boolean      @default(true)

  brandPrimaryColor    String?
  brandSecondaryColor  String?
  logoUrl              String?
  proposalFooterText   String?
  /// Agency's own proposal disclaimer. Null falls back to the platform default
  /// in lib/proposals/branding.ts, which Super Admin maintains.
  proposalDisclaimerText String?

  /// The Desk (outsourced operations) is an add-on, off until an admin enables it.
  deskEnabled          Boolean   @default(false)
  deskEnabledAt        DateTime?
  /// The agency's management system. AMS work is done manually by Pod 1.
  amsSystem            AmsSystem?
  /// Name of the AMS when amsSystem is OTHER.
  amsSystemOther       String?
  /// Agency-specific instructions for Desk staff. Must never contain passwords
  /// (lib/desk/profile.ts looksLikeCredential refuses them).
  deskInstructions     String?
  /// Where the agency's AMS / carrier logins live in the password manager,
  /// e.g. "1Password › Desk › Acme Insurance". A pointer only — never a secret.
  credentialVaultRef   String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                User[]
  intakeForms          IntakeForm[]
  intakeSubmissions    IntakeSubmission[]
  leads                Lead[]
  carriers             Carrier[]
  appetiteRules        CarrierAppetiteRule[]
  quoteOptions         QuoteOption[]
  proposals            Proposal[]
  aiRuns               AiRun[]
  billingAccount       BillingAccount?
  leadCarrierFits      LeadCarrierFit[]
  deskAssignment       AgencyDeskAssignment?
  podAccess            AgencyPodAccess[]
  insureds             InsuredAccount[]
  policies             Policy[]
  importBatches        ImportBatch[]
  importColumnMemory   ImportColumnMemory?
  tasks                Task[]
  deskPlan             AgencyDeskPlan?
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId     String?  @db.ObjectId
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  /// Desk book access, set by the agency admin. Null = the role's default
  /// (lib/roles.ts effectiveBookAccess). Ignored for ADMIN, who always sees all.
  bookAccess   BookAccess?
  lastLoginAt  DateTime?
  lastActivityAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency       Agency?  @relation(fields: [agencyId], references: [id])
  leads        Lead[]   @relation("AssignedLeads")
  activityEvents ActivityEvent[] @relation("UserEvents")
  sessions     Session[]
  inviteTokens InviteToken[]
  passwordResetTokens PasswordResetToken[]
  createdProposals Proposal[] @relation("CreatedProposals")
  podMemberships   PodMember[]
  primaryAmFor     AgencyDeskAssignment[] @relation("PrimaryAccountManager")
  backupAmFor      AgencyDeskAssignment[] @relation("BackupAccountManager")
  agencyPodAccess  AgencyPodAccess[]
  importBatches    ImportBatch[]
  amTasks          Task[] @relation("TaskAccountManager")
  assignedTasks    Task[] @relation("TaskAssignee")
  insuredAssignments InsuredAssignment[]
  deskPermission   DeskStaffPermission?

  @@index([role])
}

/// One-time password-reset codes. The 6-digit code is stored hashed (never
/// plaintext), is single-use, expires quickly, and limits verification attempts.
model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time invite links. A separate model (rather than a nullable @unique field
/// on User) because MongoDB's unique index rejects a second null — every row here
/// always has a token. The invitee sets their own password via this link, so no
/// password is ever sent by email.
model InviteToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  token     String    @unique
  userId    String    @db.ObjectId
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model IntakeForm {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  agencyId         String           @db.ObjectId
  lob              LineOfBusiness
  name             String
  definition       Json
  isActive         Boolean          @default(true)
  isPublic         Boolean          @default(false)
  publicToken      String?          @unique
  presentationMode PresentationMode @default(STANDARD)
  allowModeToggle  Boolean          @default(false)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  agency      Agency         @relation(fields: [agencyId], references: [id])
  submissions IntakeSubmission[]
}

model IntakeSubmission {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId        String   @db.ObjectId
  intakeFormId    String   @db.ObjectId
  insuredName     String
  contactEmail    String?
  responses       Json
  completenessScore Int    @default(0)
  createdAt       DateTime @default(now())

  agency          Agency   @relation(fields: [agencyId], references: [id])
  intakeForm      IntakeForm @relation(fields: [intakeFormId], references: [id])
  lead            Lead?
}

model Lead {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  agencyId             String              @db.ObjectId
  intakeSubmissionId   String?             @unique @db.ObjectId
  assignedToId         String?             @db.ObjectId
  lob                  LineOfBusiness     @default(COMMERCIAL_GL)

  insuredName            String
  primaryContactEmail    String?
  status                 LeadStatus        @default(NEW)
  source                 LeadSource        @default(INTERNAL)

  marketClassification   MarketClassification?
  marketConfidence       Float?
  marketReasonCodes      String[]           @default([])

  // Archived leads are hidden from the main list and live in the Archived view.
  archivedAt             DateTime?

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  agency                 Agency             @relation(fields: [agencyId], references: [id])
  intakeSubmission       IntakeSubmission?  @relation(fields: [intakeSubmissionId], references: [id])
  assignedTo             User?              @relation("AssignedLeads", fields: [assignedToId], references: [id])

  carrierFits            LeadCarrierFit[]
  quoteOptions           QuoteOption[]
  proposals              Proposal[]
  aiRuns                 AiRun[]
}

model Carrier {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  agencyId     String            @db.ObjectId
  name         String
  marketType   CarrierMarketType @default(STANDARD)
  enabled      Boolean           @default(true)
  priorityRank Int               @default(100)
  notes        String?
  isActive     Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency        Agency               @relation(fields: [agencyId], references: [id])
  appetiteRules CarrierAppetiteRule[]
  appetiteGuides AppetiteGuide[]
  carrierFits   LeadCarrierFit[]
  quoteOptions  QuoteOption[]

  @@unique([agencyId, name])
}

model CarrierAppetiteRule {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  agencyId             String         @db.ObjectId
  carrierId            String         @db.ObjectId
  lob                  LineOfBusiness @default(COMMERCIAL_GL)
  version              Int            @default(1)
  
  allowedIndustries    String[]       @default([])
  excludedIndustries   String[]       @default([])
  allowedStates        String[]       @default([])
  excludedStates       String[]       @default([])
  minRevenue           Int?
  maxRevenue           Int?
  minEmployees         Int?
  maxEmployees         Int?
  minYearsInBusiness   Int?
  lossHistoryYears     Int            @default(5)
  maxLossCount         Int?
  maxLossAmount        Int?
  
  rules                Json?
  summary              String?
  isActive             Boolean        @default(true)
  isAgencyOverride     Boolean        @default(false)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  agency    Agency         @relation(fields: [agencyId], references: [id])
  carrier   Carrier        @relation(fields: [carrierId], references: [id])

  @@unique([carrierId, lob, version])
}

model AppetiteGuide {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  carrierId   String   @db.ObjectId
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  notes       String?
  uploadedAt  DateTime @default(now())

  carrier     Carrier  @relation(fields: [carrierId], references: [id])
}

model LeadCarrierFit {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String         @db.ObjectId
  leadId    String         @db.ObjectId
  carrierId String         @db.ObjectId
  tier      CarrierFitTier
  score     Float?
  reasons   String[]       @default([])
  notes     String?
  createdAt DateTime       @default(now())

  agency    Agency         @relation(fields: [agencyId], references: [id])
  lead      Lead           @relation(fields: [leadId], references: [id])
  carrier   Carrier        @relation(fields: [carrierId], references: [id])

  @@unique([leadId, carrierId])
}

/// A single carrier quote option attached to a Lead. An agent adds one of these
/// per quote received back from a carrier, and a Proposal presents several of
/// them side by side for the insured to compare and choose between.
///
/// Money is stored in whole cents as BigInt (matching the rest of the schema) so
/// premiums are never subject to floating-point drift.
model QuoteOption {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String   @db.ObjectId
  leadId    String   @db.ObjectId
  carrierId String?  @db.ObjectId

  // ── Identity ──
  /// Agent-facing label, e.g. "Option 1". Falls back to the carrier name in UI.
  optionLabel    String?
  /// Free-text carrier name, used when the quote is from a carrier that is not
  /// in the agency's carrier list (e.g. an E&S market placed through a broker).
  carrierName    String?
  programName    String?
  lineOfBusiness LineOfBusiness?
  policyType     String?

  // ── Dates ──
  effectiveDate       DateTime?
  expirationDate      DateTime?
  /// When the carrier's quote itself goes stale, distinct from the policy term.
  quoteExpirationDate DateTime?

  // ── Cost (whole cents) ──
  premiumAnnualCents BigInt?
  taxesCents         BigInt?
  feesCents          BigInt?
  totalAnnualCents   BigInt?
  paymentPlan        String?

  // ── Coverage detail ──
  /// [{ name, limit, deductible, included, explanation, whyItMatters, agentEdited }]
  coverages    Json?
  limits       Json?
  deductibles  Json?
  endorsements Json?
  exclusions   Json?

  notes        String?

  // ── Uploaded carrier quote document ──
  /// Object key in R2, never a URL. Links are presigned per request so access
  /// stays behind the agency check and no long-lived public URL ever exists.
  documentKey         String?
  documentName        String?
  documentSize        Int?
  documentContentType String?
  documentUploadedAt  DateTime?

  /// Exactly one option per proposal should carry the agent's recommendation.
  /// Enforced in application code, not by the database.
  isRecommended Boolean @default(false)
  /// "Why We Recommend This Option" — agent-written or AI-drafted then edited.
  /// Lives on the option so it survives before a proposal exists; a proposal
  /// copies it into Proposal.recommendationText at build time.
  recommendationRationale String?
  /// True while the rationale is an unedited AI draft, so unreviewed text
  /// cannot reach the insured.
  rationaleAiDrafted      Boolean @default(false)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency    Agency   @relation(fields: [agencyId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id])
  carrier   Carrier? @relation(fields: [carrierId], references: [id])

  @@index([agencyId])
  @@index([leadId])
  @@index([leadId, sortOrder])
}

model Proposal {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String        @db.ObjectId
  leadId    String        @db.ObjectId
  createdByUserId String?  @db.ObjectId

  status    ProposalStatus @default(DRAFT)
  title     String

  /// Increments each time a sent proposal is edited. A signed version is never
  /// mutated — editing one creates the next version instead.
  version   Int            @default(1)
  /// The proposal this one superseded, forming a chain back through the history.
  /// Superseded versions are retained read-only for the audit trail.
  supersedesProposalId String? @db.ObjectId
  /// Set on a version that has been replaced by a newer one.
  supersededAt         DateTime?

  // ── Market-classification proposal (original feature, retained) ──
  marketClassification MarketClassification?
  marketConfidence Float?
  marketSummary String?
  agentRecommendation String?
  snapshot  Json?
  quoteIds  String[]       @default([])

  // ── Quote proposal ──
  /// The option the insured chose. Set at selection time, before signing.
  selectedQuoteOptionId String?  @db.ObjectId
  /// "Why We Recommend This Option" — agent-written or AI-drafted then edited.
  recommendationText    String?
  /// Covering note shown to the insured when the proposal is delivered.
  clientMessage         String?
  /// Resolved at send time from the agency default so a sent proposal keeps the
  /// exact disclaimer it was sent with, even if the agency later changes theirs.
  disclaimerText        String?
  /// Ordered proposal sections: [{ key, title, enabled, body }]
  sections              Json?

  // ── Secure client link ──
  publicToken    String?   @unique
  tokenRevokedAt DateTime?

  // ── Lifecycle timestamps ──
  sentAt     DateTime?
  /// Legacy timestamp from the SHARED status. Retained so existing rows keep
  /// their history; new code writes sentAt.
  sharedAt   DateTime?
  viewedAt   DateTime?
  selectedAt DateTime?
  signedAt   DateTime?
  expiresAt  DateTime?
  /// Set when a signature completes. A locked proposal is immutable.
  lockedAt   DateTime?
  /// The complete client-facing proposal frozen at the moment of signature.
  ///
  /// Data sections (options, coverages, comparison) normally render from the
  /// lead's live quote options, so without this an agent editing a quote after
  /// signature would silently change the document the insured agreed to. Once
  /// set, the public view serves this instead of re-assembling.
  signedSnapshot Json?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  agency     Agency        @relation(fields: [agencyId], references: [id])
  lead       Lead          @relation(fields: [leadId], references: [id])
  createdBy  User?         @relation("CreatedProposals", fields: [createdByUserId], references: [id])

  signatures ProposalSignature[]
  events     ProposalActivityEvent[]

  @@index([agencyId])
  @@index([leadId])
  @@index([status])
}

/// An insured's electronic signature on one version of one proposal.
///
/// Rows here are append-only evidence: they are never updated or deleted, and they
/// carry everything needed to demonstrate intent to sign under ESIGN/UETA — who
/// signed, what they agreed to, which exact proposal version, and from where.
model ProposalSignature {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String  @db.ObjectId
  /// Denormalised for agency-scoped queries without joining through Proposal.
  agencyId   String  @db.ObjectId

  signerName    String
  signerEmail   String?
  signerTitle   String?
  signatureType SignatureType @default(TYPED)
  /// Typed name, or a data-URL image for a drawn signature.
  signatureData String

  consentAccepted Boolean @default(false)
  /// The exact consent wording shown at signing time, stored verbatim.
  consentText     String?

  /// Which option was selected at the moment of signing, and against which
  /// version — both frozen here so later edits cannot rewrite what was signed.
  selectedQuoteOptionId String? @db.ObjectId
  proposalVersion       Int

  signedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?

  proposal  Proposal @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
  @@index([agencyId])
}

/// Timeline entry for the E-Sign Activity log shown to the Agent and Agency Admin.
model ProposalActivityEvent {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String            @db.ObjectId
  agencyId   String            @db.ObjectId
  eventType  ProposalEventType
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime          @default(now())

  proposal   Proposal          @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
  @@index([agencyId])
  @@index([createdAt])
}

enum AiRunStatus {
  COMPLETED
  FAILED
}

model AiRun {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  agencyId      String?     @db.ObjectId
  leadId        String?     @db.ObjectId
  purpose       String
  status        AiRunStatus @default(COMPLETED)
  model         String?
  promptVersion String?

  // What was sent to the model (for audit/history) and what came back.
  inputSnapshot Json?
  output        Json
  usage         Json?
  error         String?

  // Agent review trail. Set when a licensed agent reviews/approves the output.
  reviewedById  String?     @db.ObjectId
  reviewedAt    DateTime?

  createdAt     DateTime    @default(now())

  agency        Agency?     @relation(fields: [agencyId], references: [id])
  lead          Lead?       @relation(fields: [leadId], references: [id])

  @@index([agencyId])
  @@index([leadId])
  @@index([purpose])
  @@index([createdAt])
}

enum AcordFormType {
  ACORD_125
  ACORD_126
  ACORD_140
  ACORD_25
  ACORD_130
}

enum AcordDraftStatus {
  DRAFT
  REVIEWED
  EXPORTED
}

/// Generated ACORD form data — stored separately from the original intake for
/// audit/history, per the AI build direction. `fields` holds the mapped form
/// values (agent-editable); `missingFields` are required keys still blank.
model AcordDraft {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  agencyId      String           @db.ObjectId
  leadId        String           @db.ObjectId
  formType      AcordFormType
  status        AcordDraftStatus @default(DRAFT)

  fields        Json
  missingFields String[]         @default([])

  // Agent review/approval trail before export.
  reviewedById  String?          @db.ObjectId
  reviewedAt    DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([agencyId])
  @@index([leadId])
  @@index([formType])
}

/// Agent-editable coverage recommendations for a lead. Seeded deterministically
/// from intake exposures (+ optional AI-refined explanations), then the agent can
/// edit levels, remove, or add coverages and approve before use in a proposal.
/// One current set per lead. Stored separately for audit/history.
model CoverageRecommendationSet {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  agencyId        String    @db.ObjectId
  leadId          String    @unique @db.ObjectId
  recommendations Json
  status          String    @default("DRAFT") // DRAFT | REVIEWED
  reviewedById    String?   @db.ObjectId
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agencyId])
}

/// Super-admin-editable overrides for the coverage rules library. Global (one
/// row per coverage). Lets non-developers enable/disable coverages, override the
/// plain-English explanation, and add custom coverages — without code changes.
/// The engine's conditional level logic stays in code; these overrides are
/// merged on top of its output.
model CoverageRuleConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  coverageName     String   @unique
  enabled          Boolean  @default(true)
  agentExplanation String?  // override; null = use library default
  isCustom         Boolean  @default(false)
  customLevel      String?  // STRONGLY_RECOMMENDED | RECOMMENDED | CONSIDER | NOT_TYPICALLY_NEEDED
  customReason     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BillingAccount {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String   @unique @db.ObjectId
  stripeCustomerId String?
  stripeSubscriptionId String?
  planCode  String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency    Agency   @relation(fields: [agencyId], references: [id])
}

model ActivityEvent {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  agencyId    String?           @db.ObjectId
  userId      String?           @db.ObjectId
  leadId      String?           @db.ObjectId
  eventType   ActivityEventType
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime          @default(now())

  user        User?             @relation("UserEvents", fields: [userId], references: [id])

  @@index([agencyId])
  @@index([userId])
  @@index([leadId])
  @@index([eventType])
  @@index([createdAt])
}

// ─── The Desk: organisation ─────────────────────────────────────────────────

/// A specialised team with its own task queue (Service & AMS, Renewals, New
/// Business, QA). `code` is the stable key used by routing rules and seed data;
/// `name` is display text an admin may change.
model Pod {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       PodMember[]
  agencyAccess  AgencyPodAccess[]
  tasks         Task[]
  routingRules  TaskRoutingRule[]
  followUpRules TaskFollowUpRule[]
}

/// A Desk staff member in a pod. Usually a DESK_VA; an ACCOUNT_MANAGER may also
/// sit in a pod (e.g. QA, which AMs cover initially). A user may be in several pods.
model PodMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  podId     String   @db.ObjectId
  userId    String   @db.ObjectId
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@index([userId])
}

/// One per Desk agency: its primary Account Manager and an optional backup.
/// One AM can be primary for many agencies.
model AgencyDeskAssignment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId    String   @unique @db.ObjectId
  primaryAmId String?  @db.ObjectId
  backupAmId  String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  primaryAm   User?    @relation("PrimaryAccountManager", fields: [primaryAmId], references: [id])
  backupAm    User?    @relation("BackupAccountManager", fields: [backupAmId], references: [id])

  @@index([primaryAmId])
  @@index([backupAmId])
}

/// Which pods — and optionally which of their members — may work an agency.
///  userId = null → every member of the pod is authorised for the agency.
///  userId set    → only that member is (an allow-list for sensitive agencies).
/// A VA can work an agency's task only through a matching row here AND a
/// membership of that pod. Rows are only ever created explicitly.
model AgencyPodAccess {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String   @db.ObjectId
  podId     String   @db.ObjectId
  userId    String?  @db.ObjectId
  createdAt DateTime @default(now())

  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, podId, userId])
  @@index([podId])
  @@index([userId])
}

// ─── The Desk: book of business ─────────────────────────────────────────────

enum InsuredStatus {
  ACTIVE
  INACTIVE
}

enum InsuredSource {
  MANUAL
  IMPORT
  LEAD_CONVERSION
}

enum PolicyStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
}

/// An insured the agency services through The Desk — its book of business.
/// Distinct from Lead, which is a prospect in the placement pipeline.
/// Optional identifiers (externalRef, convertedFromLeadId) are indexed, never
/// @unique: MongoDB's unique index rejects a second missing value.
model InsuredAccount {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  agencyId            String        @db.ObjectId

  name                String
  /// Normalised name for duplicate detection (lib/desk/insureds.ts). Always
  /// set through insuredNameKey(), never by hand.
  nameKey             String
  dba                 String?
  status              InsuredStatus @default(ACTIVE)

  contactName         String?
  contactEmail        String?
  contactPhone        String?
  website             String?

  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?

  industry            String?
  description         String?
  notes               String?

  /// The agency's own id for this client in their AMS.
  externalRef         String?

  source              InsuredSource @default(MANUAL)
  /// Set when created by an import; lets a whole batch be undone.
  importBatchId       String?       @db.ObjectId
  convertedFromLeadId String?       @db.ObjectId
  createdById         String?       @db.ObjectId

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  agency              Agency        @relation(fields: [agencyId], references: [id])
  policies            Policy[]
  tasks               Task[]
  assignments         InsuredAssignment[]

  @@index([agencyId, nameKey])
  @@index([agencyId, status])
  @@index([agencyId, externalRef])
  @@index([importBatchId])
  @@index([convertedFromLeadId])
}

/// A policy held by an insured. Expiration dates drive renewal work later, so
/// they are indexed per agency. Line of business is free text: agency books
/// span many lines and AMS exports label them inconsistently.
model Policy {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  agencyId       String       @db.ObjectId
  insuredId      String       @db.ObjectId

  policyNumber   String?
  lineOfBusiness String?
  /// Free-text carrier name, as on QuoteOption; carrierId links the agency's
  /// carrier list when it matches.
  carrierName    String?
  carrierId      String?      @db.ObjectId
  effectiveDate  DateTime?
  expirationDate DateTime?
  premiumCents   BigInt?
  status         PolicyStatus @default(ACTIVE)
  notes          String?
  externalRef    String?

  importBatchId  String?      @db.ObjectId
  createdById    String?      @db.ObjectId

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agency         Agency          @relation(fields: [agencyId], references: [id])
  insured        InsuredAccount  @relation(fields: [insuredId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([insuredId])
  @@index([agencyId, expirationDate])
  @@index([agencyId, policyNumber])
  @@index([importBatchId])
}

enum ImportBatchStatus {
  STAGED
  /// Being written to the book. One that stays here stopped part way, and can be undone.
  COMMITTING
  COMMITTED
  FAILED
  UNDONE
}

enum ImportRowStatus {
  PENDING
  VALID
  ERROR
  DUPLICATE
  IMPORTED
  SKIPPED
}

/// One spreadsheet upload. Rows live in ImportRow (a large book would exceed
/// MongoDB's 16 MB document limit if embedded here).
model ImportBatch {
  id                  String            @id @default(auto()) @map("_id") @db.ObjectId
  agencyId            String            @db.ObjectId
  uploadedById        String            @db.ObjectId

  fileName            String
  fileSize            Int?
  /// CSV or XLSX. The file itself is not kept, only its rows.
  format              String?
  /// The worksheet read, and all that could have been (visible ones only).
  sheetName           String?
  sheetNames          String[]          @default([])
  status              ImportBatchStatus @default(STAGED)
  /// The spreadsheet row holding the column names. 0: the file has none.
  headerRow           Int               @default(1)
  /// False when the row was a best guess, so the mapping step should ask.
  headerConfident     Boolean           @default(false)
  /// Column names in order, unique and never blank. A row's cells line up with these.
  headers             String[]          @default([])
  columnCount         Int               @default(0)
  /// What was left out because it looked like a credential: { columns: ["F"], cells: 2 }. Never the values.
  screened            Json?
  /// { field: column } chosen in the mapping step. Keyed by The Desk's own field names, never the file's.
  columnMapping       Json?

  rowCount            Int               @default(0)
  insuredsCreated     Int               @default(0)
  policiesCreated     Int               @default(0)
  rowsSkipped         Int               @default(0)

  committedAt         DateTime?
  undoneAt            DateTime?
  undoneById          String?           @db.ObjectId
  /// What undo removed and kept: counts, and the names of a few accounts kept.
  undoSummary         Json?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  agency              Agency            @relation(fields: [agencyId], references: [id])
  uploadedBy          User              @relation(fields: [uploadedById], references: [id])
  rows                ImportRow[]

  @@index([agencyId, createdAt])
}

/// How an agency mapped its export columns, so the next upload starts from it.
/// A list of { column, field } decisions, one per column name, latest first.
model ImportColumnMemory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId    String   @unique @db.ObjectId
  columns     Json
  updatedById String   @db.ObjectId
  updatedAt   DateTime @updatedAt

  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

model ImportRow {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  batchId    String          @db.ObjectId
  agencyId   String          @db.ObjectId
  /// 1-based row number as the user sees it in their spreadsheet.
  rowNumber  Int
  /// The row as parsed: an array of cell text, lined up with the batch's headers.
  /// An array, not an object keyed by column name, because those names come from
  /// the file and could be "__proto__" or "$where". Rows above the header row are
  /// stored too, so the header row can be changed without uploading again.
  data       Json
  status     ImportRowStatus @default(PENDING)
  errors     String[]        @default([])
  insuredId  String?         @db.ObjectId
  policyId   String?         @db.ObjectId

  batch      ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
}

enum InsuredAssignmentRole {
  PRODUCER
  SERVICE
}

/// An agency user responsible for an insured: its producer(s) and service
/// staff (CSRs). Users with ASSIGNED book access see only insureds they are
/// assigned to here. One row per user per insured.
model InsuredAssignment {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  agencyId    String                @db.ObjectId
  insuredId   String                @db.ObjectId
  userId      String                @db.ObjectId
  role        InsuredAssignmentRole
  createdById String?               @db.ObjectId
  createdAt   DateTime              @default(now())

  insured     InsuredAccount        @relation(fields: [insuredId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([insuredId, userId])
  @@index([agencyId, userId])
}

// ─── The Desk: tasks ────────────────────────────────────────────────────────

enum TaskType {
  COI
  ENDORSEMENT
  ACORD
  AMS_ENTRY
  POLICY_UPDATE
  DOCUMENT_UPLOAD
  RENEWAL
  REMARKETING
  LOSS_RUNS
  NEW_BUSINESS
  SUBMISSION
  PROPOSAL_PREP
  QA_REVIEW
  OTHER
}

/// Internal workflow status. Agencies see a simplified mapping (Module 6).
enum TaskStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_ON_AGENCY
  WAITING_ON_CARRIER
  WAITING_ON_INSURED
  QA_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Who or what created the task. AI-created tasks are suggestions until a
/// person accepts them (see AI_ROADMAP.md guardrails).
enum TaskSource {
  AGENCY
  INTERNAL
  SYSTEM
  AI
}

enum DeskVisibility {
  INTERNAL
  AGENCY
}

enum TaskEventKind {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  ROUTED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  NOTE
  DOCUMENT_ADDED
  DOCUMENT_REMOVED
  ESCALATED
  DEESCALATED
  SUBTASK_CREATED
  /// Complexity, priority or billing changed by an Account or Operations Manager (Module 32).
  RECLASSIFIED
}

/// A unit of Desk work, always tied to an agency and, when applicable, an
/// insured and policy. podId null = not routed yet (no rule matched); it waits
/// for the AM to triage. Writes go through the task service (Module 6) so every
/// change is recorded as a TaskEvent.
model Task {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  /// Human-friendly number shown to agencies and staff, e.g. #1042.
  reference        Int           @unique
  agencyId         String        @db.ObjectId
  insuredId        String?       @db.ObjectId
  policyId         String?       @db.ObjectId
  parentTaskId     String?       @db.ObjectId

  type             TaskType
  title            String
  description      String?
  priority         TaskPriority  @default(NORMAL)
  status           TaskStatus    @default(NEW)

  podId            String?       @db.ObjectId
  amId             String?       @db.ObjectId
  assigneeId       String?       @db.ObjectId

  /// Working due date; an AM may move it.
  dueAt            DateTime?
  /// Target set at creation from the matching ServiceLevelTarget. Never edited,
  /// so turnaround reporting measures against the original commitment.
  slaDueAt         DateTime?
  /// Copy of the target applied at creation (kind, hours / days, target id), so
  /// later edits to targets never change what an open task was promised.
  slaTarget        Json?
  /// Set while the task is in a waiting status: when the current wait began.
  /// The service-level clock is stopped until it is cleared.
  slaPausedAt      DateTime?
  /// Business minutes spent waiting so far (all completed waits). Turnaround
  /// reporting subtracts this; dueAt has already been pushed out by it.
  slaPausedMinutes Int           @default(0)

  source           TaskSource    @default(AGENCY)
  createdById      String?       @db.ObjectId
  /// Set when Insurigence AI proposed the task; links the AiRun audit trail.
  aiRunId          String?       @db.ObjectId

  escalated        Boolean       @default(false)
  escalatedAt      DateTime?
  escalationReason String?

  /// Need-to-know: when non-empty, only these Desk staff (plus the agency's
  /// Account Managers and Operations Managers) may see the task. Agency users
  /// are unaffected. Empty = normal pod access.
  restrictedToUserIds String[]   @default([]) @db.ObjectId
  restrictionReason   String?

  /// Standard or complex; drives the service-level target and is recorded for
  /// billing. Chosen by the agency, may be reclassified by staff (logged).
  complexity       TaskComplexity @default(STANDARD)

  // ── Billing (tracked now; invoicing is a later phase) ──
  /// Allowance bucket; defaults from the task type (lib/desk/billing.ts).
  serviceCategory  ServiceCategory?
  billableUnits    Int            @default(1)
  /// Internal or follow-up work that never counts or bills (e.g. the AMS
  /// update after a renewal). Set at creation, editable by staff.
  nonBillable      Boolean        @default(false)
  /// Decided once, at completion: included in the month's allowance, overage,
  /// or non-billable. Null until then.
  billingClass     BillingClass?
  billingStatus    BillingStatus?
  /// Month the task counted toward, "YYYY-MM" in the Desk time zone.
  billingPeriod    String?

  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  lastActivityAt   DateTime      @default(now())

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  agency           Agency          @relation(fields: [agencyId], references: [id])
  /// Restrict: an insured or policy with work history cannot be deleted.
  insured          InsuredAccount? @relation(fields: [insuredId], references: [id], onDelete: Restrict)
  policy           Policy?         @relation(fields: [policyId], references: [id], onDelete: Restrict)
  pod              Pod?            @relation(fields: [podId], references: [id])
  am               User?           @relation("TaskAccountManager", fields: [amId], references: [id])
  assignee         User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parent           Task?           @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtasks         Task[]          @relation("Subtasks")
  events           TaskEvent[]
  documents        TaskDocument[]

  @@index([agencyId, status])
  @@index([podId, status])
  @@index([assigneeId, status])
  @@index([amId, status])
  @@index([insuredId])
  @@index([parentTaskId])
  @@index([status, dueAt])
  @@index([agencyId, billingPeriod])
}

/// Append-only history of a task: status changes, assignments, notes and
/// documents. AGENCY entries form the agency's timeline; INTERNAL entries are
/// never shown to the agency. Defaults to INTERNAL so a mistake hides
/// information rather than leaking it.
model TaskEvent {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  taskId     String         @db.ObjectId
  agencyId   String         @db.ObjectId
  actorId    String?        @db.ObjectId
  kind       TaskEventKind
  visibility DeskVisibility @default(INTERNAL)
  body       String?
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  metadata   Json?
  createdAt  DateTime       @default(now())

  task       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([agencyId, createdAt])
}

/// A file on a task, stored privately in R2 (lib/storage/r2.ts). Removal is a
/// soft delete so the history keeps what was there.
model TaskDocument {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  taskId       String         @db.ObjectId
  agencyId     String         @db.ObjectId
  storageKey   String
  fileName     String
  fileSize     Int
  contentType  String
  visibility   DeskVisibility @default(INTERNAL)
  /// Required, no default: the uploader classifies every file, so an
  /// unclassified financial document can never fall into the open category.
  sensitivity  DocumentSensitivity
  uploadedById String?        @db.ObjectId
  deletedAt    DateTime?
  deletedById  String?        @db.ObjectId
  createdAt    DateTime       @default(now())

  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([agencyId])
}

/// Where a new task of each type goes. One rule per type; a type with no
/// active rule stays unrouted for AM triage. Edited by admins (Module 11).
model TaskRoutingRule {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  taskType        TaskType     @unique
  podId           String       @db.ObjectId
  defaultPriority TaskPriority @default(NORMAL)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  pod             Pod          @relation(fields: [podId], references: [id])
}

/// When a task of triggerType reaches triggerStatus, create a createType
/// subtask. podId null = route the new task by its routing rule.
model TaskFollowUpRule {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  triggerType   TaskType
  triggerStatus TaskStatus @default(COMPLETED)
  createType    TaskType
  podId         String?    @db.ObjectId
  titleTemplate String
  /// Follow-ups are part of the parent service, so non-billable by default.
  billable      Boolean    @default(false)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  pod           Pod?       @relation(fields: [podId], references: [id])

  @@unique([triggerType, triggerStatus, createType])
}

/// Named counters for human-friendly sequence numbers (e.g. task references).
/// Incremented atomically in lib/desk/sequence.ts.
model DeskCounter {
  id    String @id @map("_id")
  value Int
}

// ─── The Desk: agency profile & billing ─────────────────────────────────────

enum AmsSystem {
  APPLIED_EPIC
  AMS360
  HAWKSOFT
  EZLYNX
  QQCATALYST
  OTHER
}

enum TaskComplexity {
  STANDARD
  COMPLEX
}

/// Allowance buckets in a Desk plan. Each task type maps to one
/// (lib/desk/billing.ts). Managed accounts are counted separately (active
/// insureds), not as tasks.
enum ServiceCategory {
  COI
  ENDORSEMENT
  RENEWAL
  REMARKETING
  NEW_BUSINESS
  SERVICE
}

enum BillingClass {
  INCLUDED
  OVERAGE
  NON_BILLABLE
}

/// Invoicing state. Only overages are ever invoiced; included and
/// non-billable work is NOT_APPLICABLE.
enum BillingStatus {
  UNBILLED
  BILLED
  WAIVED
  NOT_APPLICABLE
}

/// A Desk subscription tier (Core / Growth / Complete). Prices and allowances
/// are data so they can change without code.
model DeskPlan {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  code              String   @unique
  name              String
  monthlyPriceCents BigInt
  /// True for "starting at" pricing (Complete); the agency's price is then
  /// set on its AgencyDeskPlan.
  priceIsStartingAt Boolean  @default(false)
  /// Managed (active) accounts included. Null = not yet configured.
  managedAccounts   Int?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  allowances        DeskPlanAllowance[]
  agencies          AgencyDeskPlan[]
}

/// Units of a service category included per month. A category with no row has
/// no allowance configured yet; monthlyUnits null = unlimited.
model DeskPlanAllowance {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  planId       String          @db.ObjectId
  category     ServiceCategory
  monthlyUnits Int?

  plan         DeskPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, category])
}

/// The plan an agency is on, with any negotiated price or allowance overrides.
model AgencyDeskPlan {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId                String   @unique @db.ObjectId
  planId                  String   @db.ObjectId
  startsOn                DateTime
  monthlyPriceCents       BigInt?
  managedAccountsOverride Int?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  agency                  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan                    DeskPlan @relation(fields: [planId], references: [id])
  allowanceOverrides      AgencyAllowanceOverride[]

  @@index([planId])
}

/// Replaces the plan's allowance for one category for this agency.
model AgencyAllowanceOverride {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  agencyDeskPlanId String          @db.ObjectId
  category         ServiceCategory
  monthlyUnits     Int?

  agencyDeskPlan   AgencyDeskPlan  @relation(fields: [agencyDeskPlanId], references: [id], onDelete: Cascade)

  @@unique([agencyDeskPlanId, category])
}

// ─── The Desk: service levels & business calendar ──────────────────────────

enum SlaTargetKind {
  /// Due N business hours or N business days after the clock starts.
  BUSINESS_TIME
  /// Anchored to the policy's expiration date (renewal work).
  BEFORE_EXPIRATION
}

/// An internal turnaround target (not a customer guarantee). The most specific
/// active target wins (lib/desk/service-levels.ts): an agency's own agreement
/// over the default, then priority, then complexity, down to type alone.
/// Exactly one of businessHours / businessDays is set for BUSINESS_TIME; days
/// stay days, so a change to business hours does not change their meaning.
model ServiceLevelTarget {
  id                         String          @id @default(auto()) @map("_id") @db.ObjectId
  taskType                   TaskType
  /// Null = applies to both complexities.
  complexity                 TaskComplexity?
  /// Null = applies to every priority.
  priority                   TaskPriority?
  /// Null = the Desk default; set = this agency's service agreement.
  agencyId                   String?         @db.ObjectId

  kind                       SlaTargetKind   @default(BUSINESS_TIME)
  businessHours              Int?
  businessDays               Int?
  /// BEFORE_EXPIRATION: work opens this many days before expiration…
  opensDaysBeforeExpiration  Int?
  /// …and is due this many days before expiration.
  dueDaysBeforeExpiration    Int?

  note                       String?
  isActive                   Boolean         @default(true)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@unique([taskType, complexity, priority, agencyId])
  @@index([taskType, isActive])
}

/// The Desk's working hours. A single row (id "default"); per-agency calendars
/// can be added later without changing targets.
model DeskCalendar {
  id             String   @id @map("_id")
  /// IANA zone, e.g. "America/New_York".
  timeZone       String
  /// ISO weekdays that are working days: 1 = Monday … 7 = Sunday.
  workDays       Int[]
  /// Minutes after midnight, local time: 540 = 9:00, 1020 = 17:00.
  dayStartMinute Int
  dayEndMinute   Int
  updatedAt      DateTime @updatedAt
}

/// A non-working date in the Desk calendar. Stored as "YYYY-MM-DD" (a calendar
/// date, not an instant) so it cannot shift with time zones.
model DeskHoliday {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      String   @unique
  name      String
  createdAt DateTime @default(now())
}

// ─── The Desk: need-to-know & audit ─────────────────────────────────────────

/// How sensitive a document is. Desk VAs see GENERAL and POLICY by default;
/// FINANCIAL and PERSONAL need an individual grant (DeskStaffPermission).
enum DocumentSensitivity {
  GENERAL
  POLICY
  FINANCIAL
  PERSONAL
}

/// Individual data permissions for a Desk staff member, on top of pod
/// membership and agency authorisation. No row = defaults only.
model DeskStaffPermission {
  id                    String                @id @default(auto()) @map("_id") @db.ObjectId
  userId                String                @unique @db.ObjectId
  /// Extra document categories this person may open, beyond the defaults.
  allowedSensitivities  DocumentSensitivity[] @default([])
  grantedById           String?               @db.ObjectId
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Which side of an agency's conversation a message came from.
enum DeskMessageSide {
  /// The agency's owners and admins.
  AGENCY
  /// Its Account Managers, or an Operations Manager.
  DESK
}

/// One message in an agency's general conversation with its Desk team
/// (Module 36). Conversations about one request are its shared notes
/// (TaskEvent), not these. Never holds credentials: lib/desk/messages.ts
/// refuses anything that looks like one.
model DeskMessage {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String          @db.ObjectId
  authorId  String?         @db.ObjectId
  side      DeskMessageSide
  body      String
  createdAt DateTime        @default(now())

  @@index([agencyId, createdAt])
}

/// How far one person has read one agency's conversation, for unread counts.
model DeskMessageRead {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId   String   @db.ObjectId
  userId     String   @db.ObjectId
  lastReadAt DateTime

  @@unique([agencyId, userId])
  @@index([userId])
}

/// Append-only record of every Desk action: creates, changes, views and
/// downloads, and refused attempts. Separate from TaskEvent (the task's story,
/// partly shown to agencies); this is the security trail and is never shown to
/// agencies. Written through lib/desk/audit.ts, which fails closed.
model DeskAuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  actorRole  String?
  /// Dotted verb, e.g. "task.status_changed", "document.downloaded".
  action     String
  entityType String
  entityId   String?
  agencyId   String?  @db.ObjectId
  /// Context; values under secret-looking keys are redacted before saving.
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
